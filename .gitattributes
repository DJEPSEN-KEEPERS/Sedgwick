# Normalize line endings to LF for all text files
* text=auto eol=lf

# Explicitly LF for source files
*.ts   eol=lf
*.tsx  eol=lf
*.js   eol=lf
*.json eol=lf
*.css  eol=lf
*.html eol=lf
*.md   eol=lf
*.yml  eol=lf
*.yaml eol=lf
*.prisma eol=lf
*.env  eol=lf

# Binary files — no conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
