generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  phone             String?
  fullName          String
  role              String    // SEDGWICK_ADMIN | INSURER_USER | CONTRACTOR_USER
  status            String    @default("ACTIVE")
  passwordHash      String
  twoFactorEnabled  Boolean   @default(true)
  twoFactorMethod   String    @default("TOTP")
  twoFactorSecret   String?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  insurerUser       InsuranceCompanyUser?
  contractorUser    ContractorUser?
  auditLogs         AuditLog[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  chatMessages      ChatMessage[]
  statusUpdates     EntrepriseStatusUpdate[]
  approvedUpdates   EntrepriseStatusUpdate[] @relation("ApprovedBy")
  finalReports      FinalReport[]
  approvedReports   FinalReport[]            @relation("ReportApprovedBy")
  selectedBids         Bid[]                    @relation("SelectedBy")
  invitedBids          BidInvitation[]          @relation("InvitedBy")
  responsibleProjects  Project[]                @relation("ResponsibleUser")
}

// ─── Insurance Companies ──────────────────────────────────────────────────────

model InsuranceCompany {
  id                String                 @id @default(cuid())
  name              String
  externalReference String?                @unique
  apiKey            String                 @unique
  status            String                 @default("active")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  users             InsuranceCompanyUser[]
  projects          Project[]
}

model InsuranceCompanyUser {
  id                 String           @id @default(cuid())
  insuranceCompanyId String
  userId             String           @unique
  createdAt          DateTime         @default(now())

  insuranceCompany   InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  user               User             @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

// ─── Contractors ──────────────────────────────────────────────────────────────

model Contractor {
  id                  String                     @id @default(cuid())
  companyName         String
  cvrNumber           String                     @unique
  contactName         String
  contactEmail        String
  contactPhone        String
  description         String?
  maxParallelProjects Int                        @default(5)
  currentWorkload     Int                        @default(0)
  status              String                     @default("active")
  sedgwickRatingAvg   Float                      @default(0)
  clientRatingAvg     Float                      @default(0)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  users               ContractorUser[]
  regions             ContractorRegion[]
  skills              ContractorSkill[]
  certifications      ContractorCertification[]
  recommendations     ContractorRecommendation[]
  bidInvitations      BidInvitation[]
  bids                Bid[]
  entreprises         Entreprise[]
  sedgwickReviews     ContractorReview[]
  clientReviews       ClientReview[]
  selectedProjects    Project[]
}

model ContractorUser {
  id           String     @id @default(cuid())
  contractorId String
  userId       String     @unique
  createdAt    DateTime   @default(now())

  contractor   Contractor @relation(fields: [contractorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  user         User       @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model ContractorRegion {
  id           String     @id @default(cuid())
  contractorId String
  regionName   String
  createdAt    DateTime   @default(now())

  contractor   Contractor @relation(fields: [contractorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model Skill {
  id          String                @id @default(cuid())
  name        String
  category    String
  createdAt   DateTime              @default(now())

  contractors ContractorSkill[]
  projects    ProjectRequiredSkill[]
}

model ContractorSkill {
  id           String     @id @default(cuid())
  contractorId String
  skillId      String
  createdAt    DateTime   @default(now())

  contractor   Contractor @relation(fields: [contractorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  skill        Skill      @relation(fields: [skillId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model ContractorCertification {
  id           String     @id @default(cuid())
  contractorId String
  name         String
  issuer       String?
  validUntil   DateTime?
  createdAt    DateTime   @default(now())

  contractor   Contractor @relation(fields: [contractorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

// ─── Projects & Entreprises ───────────────────────────────────────────────────

model Project {
  id                    String    @id @default(cuid())
  claimId               String    @unique
  insurerCaseId         String
  insurancePolicyNumber String
  insuranceCompanyId    String
  createdViaApi         Boolean   @default(true)
  creationDate          DateTime  @default(now())
  damageType            String
  damageDescription     String
  priorityLevel         String    @default("NORMAL")
  buildingType          String
  address               String
  postalCode            String
  city                  String
  region                String
  gpsLat                Float?
  gpsLng                Float?
  maxApprovedPrice      Float?
  estimatedScope        String?
  requestedStartDate    DateTime?
  requestedDeadline     DateTime?
  slaCategory           String?
  contactName           String
  contactPhone          String
  contactEmail          String
  currentMilestone      String    @default("CASE_RECEIVED")
  progressPercent       Int       @default(0)
  selectedContractorId  String?
  responsibleUserId     String?
  status                String    @default("ACTIVE")
  finalCompletionDate   DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  insuranceCompany      InsuranceCompany         @relation(fields: [insuranceCompanyId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  selectedContractor    Contractor?              @relation(fields: [selectedContractorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  responsibleUser       User?                    @relation("ResponsibleUser", fields: [responsibleUserId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  requiredSkills        ProjectRequiredSkill[]
  attachments           ProjectAttachment[]
  entreprises           Entreprise[]
  recommendations       ContractorRecommendation[]
  bidInvitations        BidInvitation[]
  chatChannels          ChatChannel[]
  bids                  Bid[]
}

model ProjectRequiredSkill {
  id        String   @id @default(cuid())
  projectId String
  skillId   String
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  skill     Skill    @relation(fields: [skillId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model ProjectAttachment {
  id                 String   @id @default(cuid())
  projectId          String
  uploadedByUserId   String
  fileName           String
  fileType           String
  blobUrl            String
  fileSizeMb         Float
  attachmentCategory String   @default("general")
  isClientVisible    Boolean  @default(false)
  createdAt          DateTime @default(now())

  project            Project  @relation(fields: [projectId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model Entreprise {
  id               String    @id @default(cuid())
  projectId        String
  contractorId     String?
  type             String    // CARPENTER | MASON | PLUMBER | GLAZIER | ELECTRICIAN | PAINTER | ROOFER | OTHER
  description      String?
  isRelevant       Boolean   @default(true)
  markedRelevantBy String?
  currentMilestone String    @default("NOT_STARTED")
  progressPercent  Int       @default(0)
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  actualStart      DateTime?
  actualEnd        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project          Project    @relation(fields: [projectId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  contractor       Contractor? @relation(fields: [contractorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  statusUpdates    EntrepriseStatusUpdate[]
  finalReport      FinalReport?
}

// ─── Bidding ──────────────────────────────────────────────────────────────────

model ContractorRecommendation {
  id           String     @id @default(cuid())
  projectId    String
  contractorId String
  matchScore   Float
  matchReason  String
  createdAt    DateTime   @default(now())

  project      Project    @relation(fields: [projectId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  contractor   Contractor @relation(fields: [contractorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model BidInvitation {
  id              String    @id @default(cuid())
  projectId       String
  contractorId    String
  invitedByUserId String
  status          String    @default("PENDING")
  invitedAt       DateTime  @default(now())
  respondedAt     DateTime?

  project         Project    @relation(fields: [projectId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  contractor      Contractor @relation(fields: [contractorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  invitedBy       User       @relation("InvitedBy", fields: [invitedByUserId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  bid             Bid?
}

model Bid {
  id               String    @id @default(cuid())
  projectId        String
  contractorId     String
  bidInvitationId  String    @unique
  bidAmount        Float
  currency         String    @default("DKK")
  comments         String?
  submittedAt      DateTime  @default(now())
  isSelected       Boolean   @default(false)
  selectedAt       DateTime?
  selectedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project          Project       @relation(fields: [projectId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  contractor       Contractor    @relation(fields: [contractorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  bidInvitation    BidInvitation @relation(fields: [bidInvitationId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  selectedBy       User?         @relation("SelectedBy", fields: [selectedByUserId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  attachments      BidAttachment[]
}

model BidAttachment {
  id         String   @id @default(cuid())
  bidId      String
  fileName   String
  fileType   String
  blobUrl    String
  fileSizeMb Float
  createdAt  DateTime @default(now())

  bid        Bid      @relation(fields: [bidId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

// ─── Progress & Final Reports ─────────────────────────────────────────────────

model EntrepriseStatusUpdate {
  id                 String    @id @default(cuid())
  entrepriseId       String
  submittedByUserId  String
  milestone          String
  progressPercent    Int
  startedFlag        Boolean   @default(false)
  completedFlag      Boolean   @default(false)
  expectedCompletion DateTime?
  comments           String?
  approvalStatus     String    @default("PENDING")
  approvedByUserId   String?
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())

  entreprise         Entreprise @relation(fields: [entrepriseId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  submittedBy        User       @relation(fields: [submittedByUserId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  approvedBy         User?      @relation("ApprovedBy", fields: [approvedByUserId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  attachments        StatusUpdateAttachment[]
}

model StatusUpdateAttachment {
  id             String                 @id @default(cuid())
  statusUpdateId String
  fileName       String
  fileType       String
  blobUrl        String
  fileSizeMb     Float
  createdAt      DateTime               @default(now())

  statusUpdate   EntrepriseStatusUpdate @relation(fields: [statusUpdateId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model FinalReport {
  id                String    @id @default(cuid())
  entrepriseId      String    @unique
  contractorId      String
  submittedByUserId String
  summary           String?
  submittedAt       DateTime?
  approvalStatus    String    @default("PENDING")
  approvedByUserId  String?
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  entreprise        Entreprise  @relation(fields: [entrepriseId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  submittedBy       User        @relation(fields: [submittedByUserId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  approvedBy        User?       @relation("ReportApprovedBy", fields: [approvedByUserId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  answers           FinalReportAnswer[]
  attachments       FinalReportAttachment[]
}

model FinalReportAnswer {
  id            String      @id @default(cuid())
  finalReportId String
  questionKey   String
  questionLabel String
  answerValue   String
  createdAt     DateTime    @default(now())

  finalReport   FinalReport @relation(fields: [finalReportId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model FinalReportAttachment {
  id            String      @id @default(cuid())
  finalReportId String
  fileName      String
  fileType      String
  blobUrl       String
  fileSizeMb    Float
  createdAt     DateTime    @default(now())

  finalReport   FinalReport @relation(fields: [finalReportId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

// ─── Chat ─────────────────────────────────────────────────────────────────────

model ChatChannel {
  id              String    @id @default(cuid())
  projectId       String
  channelType     String    // SEDGWICK_CONTRACTOR | SEDGWICK_INSURER | SEDGWICK_BIDDER
  name            String
  createdByUserId String
  createdAt       DateTime  @default(now())

  project         Project   @relation(fields: [projectId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  participants    ChatChannelParticipant[]
  messages        ChatMessage[]
}

model ChatChannelParticipant {
  id        String      @id @default(cuid())
  channelId String
  userId    String
  createdAt DateTime    @default(now())

  channel   ChatChannel @relation(fields: [channelId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model ChatMessage {
  id           String      @id @default(cuid())
  channelId    String
  senderUserId String
  messageBody  String
  messageType  String      @default("text")
  createdAt    DateTime    @default(now())

  channel      ChatChannel @relation(fields: [channelId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  sender       User        @relation(fields: [senderUserId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  attachments  ChatMessageAttachment[]
}

model ChatMessageAttachment {
  id         String      @id @default(cuid())
  messageId  String
  fileName   String
  fileType   String
  blobUrl    String
  fileSizeMb Float
  createdAt  DateTime    @default(now())

  message    ChatMessage @relation(fields: [messageId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

// ─── Notifications, Reviews & Audit ──────────────────────────────────────────

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  channel   String
  eventType String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  eventType String
  channel   String
  title     String
  message   String
  status    String    @default("pending")
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model ContractorReview {
  id             String     @id @default(cuid())
  projectId      String
  reviewerUserId String
  contractorId   String
  score          Int
  comment        String?
  createdAt      DateTime   @default(now())

  contractor     Contractor @relation(fields: [contractorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model ClientReview {
  id             String     @id @default(cuid())
  projectId      String
  reviewerUserId String
  contractorId   String
  score          Int
  comment        String?
  createdAt      DateTime   @default(now())

  contractor     Contractor @relation(fields: [contractorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  entityType   String
  entityId     String
  action       String
  oldValueJson String?  @db.Text
  newValueJson String?  @db.Text
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}
